# URL da API do site (backend Express hospedado no Render)
API_BASE_URL=https://luz-e-aroma.onrender.com

# Credenciais de acesso ao painel (troque antes de publicar)
ADMIN_USER=admin
ADMIN_PASSWORD=luzearoma

# Chave usada para assinar o cookie de sessão (use uma string longa e aleatória)
AUTH_SECRET=troque-por-uma-chave-aleatoria-longa

# Credenciais de acesso do cliente (loja). O cliente só faz login no momento da reserva.
CLIENTE_EMAIL=cliente@luzearoma.com
CLIENTE_SENHA=velas123
